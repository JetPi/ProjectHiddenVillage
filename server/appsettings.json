{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=project_hidden_village;Username=postgres"
  },
  "AdminBootstrap": {
    "Enabled": false,
    "Email": "",
    "Username": "",
    "Password": ""
  },
  "Maintenance": {
    "Enabled": false,
    "Message": "The server is restarting for a scheduled update. New games resume shortly."
  },
  "Jwt": {
    "Issuer": "ProjectHiddenVillage.Server",
    "Audience": "ProjectHiddenVillage.Client",
    "Key": "",
    "AccessTokenLifetimeMinutes": 43200
  },
  "PasswordReset": {
    "Enabled": true,
    "TokenLifetimeMinutes": 60,
    "RequestCooldownSeconds": 60,
    "MaxRequestsPerHourPerEmail": 5,
    "TokenRetentionHours": 24
  },
  "Email": {
    "Provider": "None",
    "FromAddress": "",
    "FromName": "Hidden Village",
    "AppPublicBaseUrl": "http://localhost:5173",
    "Resend": {
      "ApiKey": "",
      "BaseUrl": "https://api.resend.com"
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "CardArt": {
    "CacheDirectory": "card-art-cache",
    "UploadDirectory": "card-art-uploads",
    "MaxSourceBytes": 20971520,
    "MaxUploadBytes": 10485760,
    "MaxUploadPixels": 40000000,
    "AllowedUploadContentTypes": [ "image/png", "image/jpeg", "image/webp" ],
    "OrphanSweepEnabled": true,
    "OrphanSweepIntervalMinutes": 60,
    "OrphanGraceMinutes": 60,
    "SourceHostAllowlist": [],
    "SourceTimeoutSeconds": 15
  },
  "GamePhaseAutomation": {
    "Enabled": true,
    "PresentationAckTimeoutMs": 4000,
    "MaxDrainSteps": 16
  },
  "GameClock": {
    "Enabled": true,
    "MainPhaseSeconds": 60,
    "OtherPhaseSeconds": 30,
    "PlayerPoolSeconds": 1800,
    "TimeoutsBeforeForfeit": 3,
    "RefreshOnAction": true
  },
  "GameRedo": {
    "Enabled": true,
    "ResponseTimeoutMs": 30000,
    "MaxRewindPoints": 20
  },
  "GameRetirement": {
    "Enabled": true,
    "SweepIntervalSeconds": 60,
    "FinishedGraceSeconds": 600,
    "AbandonedGraceSeconds": 1800,
    "UnwatchedRunningGraceSeconds": 0,
    "CodeQuarantineSize": 256
  },
  "Rematch": {
    "Enabled": true,
    "ConsentLifetimeSeconds": 120,
    "ReservationLifetimeSeconds": 1800,
    "ReleaseGraceSeconds": 20,
    "OpponentPresenceGraceSeconds": 5
  },
  "GameChat": {
    "Enabled": true,
    "MaxTextLength": 500,
    "MaxMessagesPerGame": 200,
    "SendBudgetPerMinute": 30,
    "RoomIdleMinutes": 120,
    "MaxRooms": 2000,
    "SweepIntervalMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
