# Copy to .env on the server (chmod 600) and fill in. Never commit .env.
#
#   cp .env.example .env
#   sed -i "s|^POSTGRES_PASSWORD=.*|POSTGRES_PASSWORD=$(openssl rand -hex 24)|" .env
#   sed -i "s|^JWT_KEY=.*|JWT_KEY=$(openssl rand -hex 32)|" .env

# Hostnames (Cloudflare DNS, A records -> 167.233.251.253, proxy OFF)
GAME_HOST=game.shinobitactics.dev
API_HOST=api.shinobitactics.dev

# Let's Encrypt contact address
ACME_EMAIL=ibrahimzarragaam@gmail.com

# Postgres
POSTGRES_DB=project_hidden_village
POSTGRES_USER=phv
POSTGRES_PASSWORD=change-me-use-openssl-rand-hex-24

# JWT signing key (must be non-empty; 32 random bytes is plenty)
JWT_KEY=change-me-use-openssl-rand-hex-32

# Image tag to run. "latest" follows main; set a commit sha to pin or roll back.
IMAGE_TAG=latest

# First card-catalogue admin. Set ENABLED=true for one boot, then back to false:
# the seeder promotes an existing account and never rewrites its password.
# PASSWORD is only used when no account with EMAIL exists yet; clear it afterwards.
ADMIN_BOOTSTRAP_ENABLED=false
ADMIN_BOOTSTRAP_EMAIL=ibrahimzarragaam@gmail.com
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=

# Deploy drain switch: the API boots with this value, and POST /api/maintenance/disable turns it off.
MAINTENANCE_ENABLED=false
MAINTENANCE_MESSAGE=The server is restarting for a scheduled update. New games resume shortly.
